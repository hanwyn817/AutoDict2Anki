# 环境变量配置模板
# 请将此文件复制为 .env 并填写相应的值

# 欧路词典网页版 Cookie
# 登录 https://my.eudic.net/studyList 获取
EUDICT_WEB_COOKIE="your_eudict_web_cookie_here"

# 欧陆开放 API 授权信息
# 在 https://my.eudic.net/OpenAPI/Authorization 获取
UEDICT_API="your_eudict_api_key_here"

# AI API 密钥
# 用于 AI 相关功能
AI_API_KEY="Bearer sk-your_api_key_here"
AI_API_URL="https://api.siliconflow.cn/v1/chat/completions"
AI_MODEL="Pro/deepseek-ai/DeepSeek-V3"
USER_TARGET_EXAM="雅思"

# 本地词典配置
MDX_FILE_PATH="resources/Collins COBUILD (CN).mdx"
MDD_FILE_PATH="resources/Collins COBUILD (CN).mdd"

# Anki 同步方式: ankiconnect (本地 Anki 客户端) 或 ankiweb (无头网页自动化)
ANKI_SYNC_METHOD="ankiconnect"

# AnkiConnect 配置 (仅在 ANKI_SYNC_METHOD=ankiconnect 时生效)
ANKI_CONNECT_URL="http://127.0.0.1:8765"

# AnkiWeb Cookie (仅在 ANKI_SYNC_METHOD=ankiweb 时生效)
# 登录 https://ankiuser.net/add 后从浏览器请求头中获取
ANKI_WEB_COOKIE="your_anki_web_cookie_here"

# 笔记类型 (Note Type)
ANKI_NOTE_TYPE="基础"

# 目标 Anki 牌组名称
ANKI_DECK_NAME="Manki's Daily"

# Server酱 Sendkey (用于任务执行完成后的提示)
# 参考获取: https://sct.ftqq.com/
SERVERCHAN_SENDKEY="your_serverchan_sendkey_here"
